# TinyFish REST API key. Create one at https://agent.tinyfish.ai/api-keys
# Sent only as the X-API-Key header. Never commit a real value.
TINYFISH_API_KEY=

# ntfy.sh topic for push alerts. No account. The topic is the whole secret:
# anyone who knows it can read the alerts, so pick a long unguessable name.
NTFY_TOPIC=

# Optional. Defaults to the public server.
# NTFY_SERVER=https://ntfy.sh

# Optional overrides for the budgets in targets.json. Dollars.
# AGENT_BUDGET_PER_RUN_USD=0.60
# AGENT_BUDGET_PER_DAY_USD=2.00
