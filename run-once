#!/usr/bin/env python3
"""Local cron entrypoint. Forwards to `python -m rtx5090_watcher`.

  ./run-once
  ./run-once --target newegg-instock
  ./run-once demo-alert --topic your-topic
  ./run-once estimate
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))

from rtx5090_watcher.cli import main

if __name__ == "__main__":
    argv = sys.argv[1:]
    if not argv or argv[0].startswith("-"):
        argv = ["run-once", *argv]
    raise SystemExit(main(argv))
